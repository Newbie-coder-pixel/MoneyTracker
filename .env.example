# Server-only variables for the push reminder API (api/). Set them in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Generate once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Upstash Redis (free tier). The Vercel Marketplace integration may name these
# KV_REST_API_URL / KV_REST_API_TOKEN instead — both are supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Long random string; the scheduler sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate with:  openssl rand -hex 32
CRON_SECRET=
